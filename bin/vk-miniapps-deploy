#!/usr/bin/env node
const { styleText } = require('util');
const fs = require('fs');
const configFilePath = './vk-hosting-config.json';
const path = require('path');
const { confirm, text, close } = require('../readline-prompt');

async function run() {
  fs.promises.access(configFilePath).then(
    () => {},
    () => {
      console.error(configFilePath + ' is missing');
      return false;
    },
  );

  const configJSON = require(path.resolve(process.cwd(), configFilePath));
  if (!configJSON) {
    console.error(configFilePath + ' is missing');
    return false;
  }

  const deploy = require('../index');
  const cfg = configJSON || {};

  if (cfg.debug) {
    console.log('\nDebug mode is enabled. It will log all client requests!\n');
  }

  if (!cfg.noprompt) {
    const confirmation = await confirm(
      styleText('yellow', 'Would you like to deploy to VK Mini Apps hosting using these commands?'),
      true,
    );

    if (!confirmation) {
      close();
      process.exit();
    }

    const extraOptions = await getExtraOptions();
    cfg.update_prod = extraOptions.update_prod;
    cfg.update_dev = extraOptions.update_dev;

    if (extraOptions.update_test === true && extraOptions.test_group_name !== '') {
      cfg.test_group_name = extraOptions.test_group_name;
    }
  }

  const status = (await deploy.run(cfg)) ? 0 : 1;
  close();
  process.exit(status);
}

async function getExtraOptions() {
  const update_prod = await confirm(
    styleText('yellow', 'Would you like to update prod urls?'),
    true,
  );
  if (update_prod === undefined) {
    close();
    process.exit();
  }

  const update_dev = await confirm(
    styleText('yellow', 'Would you like to update dev urls?'),
    true,
  );
  if (update_dev === undefined) {
    close();
    process.exit();
  }

  const update_test = await confirm(
    styleText('yellow', 'Would you like to update test group url?'),
    false,
  );
  if (update_test === undefined) {
    close();
    process.exit();
  }

  const test_group_name = update_test
    ? await text(styleText('yellow', 'Enter test group name:'))
    : undefined;
  if (test_group_name === undefined && update_test) {
    close();
    process.exit();
  }

  if (update_prod === false && update_dev === false && update_test === false) {
    close();
    process.exit();
  }

  return { update_prod, update_dev, update_test, test_group_name };
}

run().then((r) => console.log(r));
